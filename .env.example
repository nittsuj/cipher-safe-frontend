# Copy to `.env` to override the defaults. Both are optional.

# Backend origin used by the Vite dev proxy (see vite.config.ts).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Base URL for API calls in a production build. Leave empty to use same-origin
# `/api` (dev proxy or a reverse proxy in front of the app).
VITE_API_BASE=
